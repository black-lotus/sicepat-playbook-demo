# Salin ke .env (tidak di-commit) lalu isi.
# Versi diisi saat scaffold: cek rilis stabil terbaru, samakan dengan backend/go.mod dan web/package.json.
# Contoh format: GO_VERSION=1.xx  NODE_VERSION=xx
GO_VERSION=1.26
NODE_VERSION=24

# Port di host (opsional). Ubah bila port default sudah dipakai aplikasi lain di mesin Anda.
# BACKEND_HOST_PORT=8080
# WEB_HOST_PORT=5173
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# KAFKA_HOST_PORT=9092
